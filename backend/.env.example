# PacketLens Backend Environment Configuration
PROJECT_NAME="PacketLens — Network Traffic Analyzer"
API_V1_STR="/api/v1"
SECRET_KEY="packetlens-insecure-dev-secret-key-change-in-production"

# Server Settings
HOST="127.0.0.1"
PORT=8000
DEBUG=True

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR="backend/uploads"

# Database Configuration
DATABASE_URL="sqlite:///./packetlens.db"

# Allowed CORS Origins (Frontend Dev Server)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
